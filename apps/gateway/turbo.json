{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // release-info reads the version a production build embeds from the root package.json
    "build": {
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/package.json"]
    },
    "db:push": {
      "cache": false,
      "dependsOn": ["db:generate"],
      "env": ["GATEWAY_DATABASE_URL"]
    },
    "dev": {
      "dependsOn": ["$TURBO_EXTENDS$", "db:push"]
    },
    "dev:test": {
      "dependsOn": ["$TURBO_EXTENDS$", "db:push"]
    }
  }
}
