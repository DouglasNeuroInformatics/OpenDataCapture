---
import Footer from '@/components/layout/Footer.astro';
import Head from '@/components/layout/Head.astro';
import Header from '@/components/layout/Header.astro';
import { useTranslations } from '@/i18n';
import { cn } from '@/utils';

import '@/styles/main.css';

type Props = {
  bilingual?: boolean;
  hasDefaultLocaleRedirect?: boolean;
  className?: string;
  meta?: {
    title?: string;
    description?: string;
  };
};

const { resolvedLanguage } = useTranslations(Astro.url);
const { className, ...props } = Astro.props;
---

<!doctype html>
<html lang={resolvedLanguage}>
  <Head {...props} />
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class={cn('container grow py-16', className)}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
