---
import Page from '@/layouts/Page.astro';
import { type CollectionEntry, getEntry } from 'astro:content';
import PostInfoCard from '@/components/blog/PostInfoCard.astro';
import PageHeading from '@/components/common/PageHeading.astro';
import { useTranslations } from '@/i18n';
import { getPublishedAltPost, getPublishedPosts } from '@/lib/blog';

type Props = {
  post: CollectionEntry<'blog'>;
  altPost: CollectionEntry<'blog'> | undefined;
};

export const getStaticPaths = async () => {
  const posts = await getPublishedPosts();

  const paths = posts.map(async (post) => ({
    params: {
      locale: post.data.language,
      slug: post.slug
    },
    props: { altPost: await getPublishedAltPost(post), post }
  }));

  return Promise.all(paths);
};

const { altPost, post } = Astro.props;
const { altLanguage } = useTranslations(Astro.url);
const altURL = new URL(`/${altLanguage}/blog/${altPost?.slug ?? ''}`, Astro.url);

const { Content, remarkPluginFrontmatter } = await post.render();

const author = await getEntry(post.data.author);
---

<Page altURL={altURL} meta={{ title: post.data.title, description: post.data.description }}>
  <article class="prose prose-slate dark:prose-invert relative mx-auto max-w-3xl pt-8">
    <PageHeading className="pb-0 text-left" title={post.data.title} />
    <PostInfoCard
      author={author}
      className="not-prose"
      datePublished={post.data.datePublished}
      readingTime={remarkPluginFrontmatter.readingTime}
    />
    <Content />
  </article>
</Page>
