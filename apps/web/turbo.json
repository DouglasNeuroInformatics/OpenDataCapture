{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // release-info reads the version a production build embeds from the root package.json
    "build": {
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/package.json"],
      "env": ["API_BASE_URL", "CONTACT_EMAIL", "DOCS_URL", "GATEWAY_ENABLED", "GITHUB_REPO_URL", "LICENSE_URL"]
    }
  }
}
