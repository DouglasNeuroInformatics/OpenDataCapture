{
  "name": "opendatacapture",
  "version": "2.7.1",
  "private": true,
  "license": "Apache-2.0",
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "type": "module",
  "scripts": {
    "build": "env-cmd turbo run build",
    "build:exports": "turbo run build --filter=@opendatacapture/instrument-library... --output-logs=errors-only",
    "check": "pnpm lint && pnpm test:coverage && pnpm test:e2e",
    "clean": "find . -type d '(' -name '.turbo' -o -name 'dist' -o -name 'node_modules' ')' -prune -exec rm -rf {} \\;",
    "clean:workflows": "./scripts/clean-workflows.sh",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "dev": "pnpm dev:core",
    "dev:all": "NODE_ENV=development env-cmd turbo run dev",
    "dev:core": "NODE_ENV=development env-cmd pnpm exec turbo run dev --filter=@opendatacapture/api --filter=@opendatacapture/gateway --filter=@opendatacapture/web",
    "dev:test": "NODE_ENV=test env-cmd turbo run dev:test",
    "force-reinstall": "pnpm clean && pnpm install",
    "format": "oxfmt",
    "generate:env": "./scripts/generate-env.sh",
    "knip": "NODE_ENV=development env-cmd knip",
    "lint": "turbo run lint lint:root",
    "lint:root": "oxlint --type-check --fix",
    "postinstall": "turbo telemetry disable",
    "prepare": "husky",
    "start": "turbo run start",
    "test": "pnpm build:exports && env-cmd vitest",
    "test:coverage": "pnpm build:exports && ./scripts/with-test-lock.sh env-cmd vitest --coverage",
    "test:e2e": "./scripts/with-test-lock.sh env-cmd turbo run test:e2e",
    "ws": "./scripts/workspace.sh $@"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@douglasneuroinformatics/tsconfig": "^3.0.0",
    "@opendatacapture/oxlint-config": "workspace:*",
    "@types/node": "24.x",
    "@vitest/coverage-v8": "^5.0.2",
    "conventional-commits-parser": "catalog:",
    "env-cmd": "^11.0.0",
    "expect-type": "^1.4.0",
    "husky": "^9.1.7",
    "js-yaml": "^5.4.2",
    "knip": "^6.38.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "sort-json": "^2.0.1",
    "tsx": "catalog:",
    "turbo": "^2.11.5",
    "typescript": "catalog:",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "packageManager": "pnpm@10.34.3",
  "__isODCRepo": true
}
