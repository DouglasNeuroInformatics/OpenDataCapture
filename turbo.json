{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["tsconfig.json"],
  "globalEnv": ["RELEASE_VERSION"],
  "globalPassThroughEnv": ["NODE_OPTIONS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/__tests__/**"],
      "outputs": ["dist/**"]
    },
    "db:generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["node_modules/@prisma/generated-client/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^build", "db:generate"],
      "persistent": true
    },
    "dev:test": {
      "cache": false,
      "dependsOn": ["^build", "db:generate"],
      "persistent": true
    },
    // What a tool run over the whole repo reads that source control does not hold. The library builds
    // reach runtime-core and runtime-v1 through ^build.
    "//#generated": {
      "dependsOn": [
        "@opendatacapture/api#db:generate",
        "@opendatacapture/gateway#db:generate",
        "@opendatacapture/instrument-library#build",
        "@opendatacapture/outreach#gen:types",
        "@opendatacapture/testing#gen:routes"
      ]
    },
    "//#lint:root": {
      "dependsOn": ["//#generated"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.mdx"]
    },
    "start": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "@opendatacapture/testing#test:e2e": {
      "cache": false,
      "dependsOn": [
        "^build",
        "//#generated",
        "@opendatacapture/gateway#build",
        "@opendatacapture/gateway#db:push",
        "@opendatacapture/playground#build",
        "@opendatacapture/web#build"
      ]
    }
  }
}
